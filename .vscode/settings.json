{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "files.associations": {
        "*.cpp": "cpp",
        "*.h": "cpp",
        "Makefile": "makefile",
        "Makeassets": "makefile",
        "Maketests": "makefile",
        ".clang-tidy": "yaml",
        ".clang-format": "yaml",
        ".clangd": "yaml",
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
}